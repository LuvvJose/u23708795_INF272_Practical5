@model Prac2.Models.People

@{
    ViewBag.Title = "CreateNew";
}

<h2>Create</h2>

@using (Html.BeginForm("CreateNew", "People", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
{
    <div class="container mt-5">
        <h2 class="mb-4">Your details</h2>

        <!-- Student Number Field -->
        <div class="mb-3">
            @Html.LabelFor(m => m.StudentNumber, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.StudentNumber, new { @class = "form-control", @placeholder = "Enter Student Number", required = "required" })
            <div class="invalid-feedback">Student Number is required.</div>
        </div>

        <!-- First Name Field -->
        <div class="mb-3">
            @Html.LabelFor(m => m.FirstName, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", @placeholder = "Enter First Name", required = "required" })
            <div class="invalid-feedback">First Name is required.</div>
        </div>

        <!-- Last Name Field -->
        <div class="mb-3">
            @Html.LabelFor(m => m.LastName, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", @placeholder = "Enter Last Name", required = "required" })
            <div class="invalid-feedback">Last Name is required.</div>
        </div>

        <!-- Email Address Field -->
        <div class="mb-3">
            @Html.LabelFor(m => m.Email, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @placeholder = "Enter Your Email", required = "required", type = "email" })
            <div class="invalid-feedback">Please enter a valid email address.</div>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn btn-primary">Create</button>

        <br /><br />

        <div>
            <a class="nav-link text-primary" href="@Url.Action("PeopleList", "People")">Back to List</a>
        </div>
    </div>
}


<!-- Validation -->

<script>
    (function () {
        'use strict';
        var forms = document.querySelectorAll('.needs-validation');

        Array.prototype.slice.call(forms).forEach(function (form) {
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });
    })();
</script>

<!-- JavaScript to handle form submission and local storage -->

<script>
    document.getElementById("submitButton").addEventListener("click", function () {
        const studentNumber = document.getElementById("StudentNumber").value;
        const firstName = document.getElementById("FirstName").value;
        const lastName = document.getElementById("LastName").value;
        const email = document.getElementById("Email").value;

        if ([studentNumber, firstName, lastName, email].includes('')) {
            alert("All fields are required.");
            return;
        }

        const newRow = `${studentNumber}|${firstName}|${lastName}|${email}`;
        const existingData = localStorage.getItem("peopleTableData") || "";
        localStorage.setItem("peopleTableData", existingData + (existingData ? "\n" : "") + newRow);

        window.location.href = "@Url.Action("PeopleList", "People")";
    });
</script>



